{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/auto-fmt.sh",
            "timeout": 30,
            "statusMessage": "formatting rust"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/clippy.sh",
            "async": true,
            "timeout": 180,
            "statusMessage": "running clippy",
            "asyncRewake": true,
            "rewakeMessage": "clippy findings on the workspace — fix them or say why they stand, then continue:",
            "rewakeSummary": "clippy found issues"
          }
        ]
      }
    ]
  }
}
