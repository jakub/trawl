---
source: crates/trawl-engine/tests/schema_probe.rs
expression: cold_only
---
-- cold-only: login
SELECT *
FROM read_parquet(['<dir>/cold/10/*.parquet', '<dir>/cold/11/*.parquet'], union_by_name=true)
WHERE (COALESCE((CASE WHEN typeof("message") = 'VARCHAR' THEN CAST("message" AS VARCHAR) WHEN typeof("message") = 'JSON' AND json_type(CAST("message" AS JSON)) = 'VARCHAR' THEN json_extract_string(CAST("message" AS JSON), '$') ELSE NULL END) ILIKE ? ESCAPE '\', FALSE) OR COALESCE((CASE WHEN typeof("_raw") = 'VARCHAR' THEN CAST("_raw" AS VARCHAR) WHEN typeof("_raw") = 'JSON' AND json_type(CAST("_raw" AS JSON)) = 'VARCHAR' THEN json_extract_string(CAST("_raw" AS JSON), '$') ELSE NULL END) ILIKE ? ESCAPE '\', FALSE))

-- cold-only: login host=web1 status>=500
SELECT *
FROM read_parquet(['<dir>/cold/10/*.parquet', '<dir>/cold/11/*.parquet'], union_by_name=true)
WHERE (COALESCE((CASE WHEN typeof("message") = 'VARCHAR' THEN CAST("message" AS VARCHAR) WHEN typeof("message") = 'JSON' AND json_type(CAST("message" AS JSON)) = 'VARCHAR' THEN json_extract_string(CAST("message" AS JSON), '$') ELSE NULL END) ILIKE ? ESCAPE '\', FALSE) OR COALESCE((CASE WHEN typeof("_raw") = 'VARCHAR' THEN CAST("_raw" AS VARCHAR) WHEN typeof("_raw") = 'JSON' AND json_type(CAST("_raw" AS JSON)) = 'VARCHAR' THEN json_extract_string(CAST("_raw" AS JSON), '$') ELSE NULL END) ILIKE ? ESCAPE '\', FALSE)) AND "host" = ? AND "status" >= ?

-- cold-only: service=api OR host!=web2
SELECT *
FROM read_parquet(['<dir>/cold/10/*.parquet', '<dir>/cold/11/*.parquet'], union_by_name=true)
WHERE (("service" = ?) OR (("host" != ? OR "host" IS NULL)))

-- cold-only: earliest="2024-01-15T10:00:00Z" host=web*
SELECT *
FROM read_parquet(['<dir>/cold/10/*.parquet', '<dir>/cold/11/*.parquet'], union_by_name=true)
WHERE TRY_CAST("_time" AS TIMESTAMP) >= CAST(? AS TIMESTAMP) AND "host" GLOB ?

-- cold-only: * | where status >= 500 and duration > 1.5
SELECT *
FROM read_parquet(['<dir>/cold/10/*.parquet', '<dir>/cold/11/*.parquet'], union_by_name=true)
WHERE (("status" >= ?) AND ("duration" > ?))

-- cold-only: * | where lower(host) == "web1" or isnull(service)
SELECT *
FROM read_parquet(['<dir>/cold/10/*.parquet', '<dir>/cold/11/*.parquet'], union_by_name=true)
WHERE ((LOWER("host") = ?) OR ("service" IS NULL))

-- cold-only: * | let slow = duration > 1.0, code = status * 2 | table host, slow, code
WITH _s0 AS (
  SELECT *
  FROM read_parquet(['<dir>/cold/10/*.parquet', '<dir>/cold/11/*.parquet'], union_by_name=true)
), _s1 AS (
  SELECT COLUMNS(c -> translate(c, 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz') NOT IN ('slow', 'code')), (("duration" > ?)) AS "slow", (("status" * ?)) AS "code"
  FROM "_s0"
)
SELECT "host", "slow", "code"
FROM "_s1"

-- cold-only: host=web1 | table _time, host, status, message
SELECT "_time", "host", "status", "message"
FROM read_parquet(['<dir>/cold/10/*.parquet', '<dir>/cold/11/*.parquet'], union_by_name=true)
WHERE "host" = ?

-- cold-only: * | fields host, status
SELECT "host", "status"
FROM read_parquet(['<dir>/cold/10/*.parquet', '<dir>/cold/11/*.parquet'], union_by_name=true)

-- cold-only: * | rename host as server | table server, status
WITH _s0 AS (
  SELECT COLUMNS(c -> translate(c, 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz') NOT IN ('host', 'server')), "host" AS "server"
  FROM read_parquet(['<dir>/cold/10/*.parquet', '<dir>/cold/11/*.parquet'], union_by_name=true)
)
SELECT "server", "status"
FROM "_s0"

-- cold-only: * | stats count() as n, avg(duration) as d by host
SELECT "host", COUNT(*) AS "n", AVG("duration") AS "d"
FROM read_parquet(['<dir>/cold/10/*.parquet', '<dir>/cold/11/*.parquet'], union_by_name=true)
GROUP BY "host"

-- cold-only: * | timechart span=1h count() by host
SELECT time_bucket(INTERVAL '1 hours', TRY_CAST("_time" AS TIMESTAMP)) AS "_time", "host", COUNT(*) AS "count"
FROM read_parquet(['<dir>/cold/10/*.parquet', '<dir>/cold/11/*.parquet'], union_by_name=true)
GROUP BY time_bucket(INTERVAL '1 hours', TRY_CAST("_time" AS TIMESTAMP)), "host"
ORDER BY time_bucket(INTERVAL '1 hours', TRY_CAST("_time" AS TIMESTAMP)) ASC

-- cold-only: * | pivot count() on service by host
WITH _s0 AS (
  SELECT *
  FROM read_parquet(['<dir>/cold/10/*.parquet', '<dir>/cold/11/*.parquet'], union_by_name=true)
), _s1 AS (
  SELECT "service", "host"
  FROM "_s0"
)
PIVOT "_s1"
ON "service"
USING COUNT(*)
GROUP BY "host"

-- cold-only: * | dedup host | table host
WITH _s0 AS (
  SELECT *
  FROM read_parquet(['<dir>/cold/10/*.parquet', '<dir>/cold/11/*.parquet'], union_by_name=true)
), _s1 AS (
  SELECT *, ROW_NUMBER() OVER (PARTITION BY "host" ORDER BY TRY_CAST("_time" AS TIMESTAMP) DESC) AS "_rn"
  FROM "_s0"
), _s2 AS (
  SELECT * EXCLUDE ("_rn")
  FROM "_s1"
  WHERE "_rn" = 1
)
SELECT "host"
FROM "_s2"

-- cold-only: * | sort -status, host | table host, status
SELECT "host", "status"
FROM read_parquet(['<dir>/cold/10/*.parquet', '<dir>/cold/11/*.parquet'], union_by_name=true)
ORDER BY "status" DESC, "host" ASC

-- cold-only: * | top 2 host
WITH _s0 AS (
  SELECT "host", COUNT(*) AS "count"
  FROM read_parquet(['<dir>/cold/10/*.parquet', '<dir>/cold/11/*.parquet'], union_by_name=true)
  GROUP BY "host"
)
SELECT *
FROM "_s0"
ORDER BY "count" DESC
LIMIT 2

-- cold-only: * | eventstats max(duration) as peak by host | where duration < peak
WITH _s0 AS (
  SELECT *
  FROM read_parquet(['<dir>/cold/10/*.parquet', '<dir>/cold/11/*.parquet'], union_by_name=true)
), _s1 AS (
  SELECT COLUMNS(c -> translate(c, 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz') NOT IN ('peak')), MAX("duration") OVER (PARTITION BY "host") AS "peak"
  FROM "_s0"
)
SELECT *
FROM "_s1"
WHERE ("duration" < "peak")

-- cold-only: * | extract "user=(?P<who>[a-z]+)" from message | table who
WITH _s0 AS (
  SELECT *
  FROM read_parquet(['<dir>/cold/10/*.parquet', '<dir>/cold/11/*.parquet'], union_by_name=true)
), _s1 AS (
  SELECT COLUMNS(c -> translate(c, 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz') NOT IN ('who')), nullif(regexp_extract("message", ?, 1), '') AS "who"
  FROM "_s0"
)
SELECT "who"
FROM "_s1"

-- cold-only: * | extract kv | stats count() by user
SELECT *
FROM read_parquet(['<dir>/cold/10/*.parquet', '<dir>/cold/11/*.parquet'], union_by_name=true)
