---
source: crates/trawl-engine/tests/schema_probe.rs
expression: hot_only
---
-- hot-only: login
SELECT *
FROM (SELECT * REPLACE (TRY_CAST("_time" AS TIMESTAMP) AS "_time", TRY_CAST("_ingested" AS TIMESTAMP) AS "_ingested", TRY_CAST(json_extract_string(to_json("duration"), '$') AS DOUBLE) AS "duration", json_extract_string(to_json("host"), '$') AS "host", (CASE WHEN TRY_CAST(json_extract_string(to_json("status"), '$') AS DECIMAL(38,6)) = TRY_CAST(TRY_CAST(json_extract_string(to_json("status"), '$') AS BIGINT) AS DECIMAL(38,6)) THEN TRY_CAST(json_extract_string(to_json("status"), '$') AS BIGINT) END) AS "status") FROM read_json('<dir>/hot.ndjson', format='newline_delimited', records=true, auto_detect=true, field_appearance_threshold=0))
WHERE (COALESCE((CASE WHEN typeof("message") = 'VARCHAR' THEN CAST("message" AS VARCHAR) WHEN typeof("message") = 'JSON' AND json_type(CAST("message" AS JSON)) = 'VARCHAR' THEN json_extract_string(CAST("message" AS JSON), '$') ELSE NULL END) ILIKE ? ESCAPE '\', FALSE) OR COALESCE((CASE WHEN typeof("_raw") = 'VARCHAR' THEN CAST("_raw" AS VARCHAR) WHEN typeof("_raw") = 'JSON' AND json_type(CAST("_raw" AS JSON)) = 'VARCHAR' THEN json_extract_string(CAST("_raw" AS JSON), '$') ELSE NULL END) ILIKE ? ESCAPE '\', FALSE))

-- hot-only: login host=web1 status>=500
SELECT *
FROM (SELECT * REPLACE (TRY_CAST("_time" AS TIMESTAMP) AS "_time", TRY_CAST("_ingested" AS TIMESTAMP) AS "_ingested", TRY_CAST(json_extract_string(to_json("duration"), '$') AS DOUBLE) AS "duration", json_extract_string(to_json("host"), '$') AS "host", (CASE WHEN TRY_CAST(json_extract_string(to_json("status"), '$') AS DECIMAL(38,6)) = TRY_CAST(TRY_CAST(json_extract_string(to_json("status"), '$') AS BIGINT) AS DECIMAL(38,6)) THEN TRY_CAST(json_extract_string(to_json("status"), '$') AS BIGINT) END) AS "status") FROM read_json('<dir>/hot.ndjson', format='newline_delimited', records=true, auto_detect=true, field_appearance_threshold=0))
WHERE (COALESCE((CASE WHEN typeof("message") = 'VARCHAR' THEN CAST("message" AS VARCHAR) WHEN typeof("message") = 'JSON' AND json_type(CAST("message" AS JSON)) = 'VARCHAR' THEN json_extract_string(CAST("message" AS JSON), '$') ELSE NULL END) ILIKE ? ESCAPE '\', FALSE) OR COALESCE((CASE WHEN typeof("_raw") = 'VARCHAR' THEN CAST("_raw" AS VARCHAR) WHEN typeof("_raw") = 'JSON' AND json_type(CAST("_raw" AS JSON)) = 'VARCHAR' THEN json_extract_string(CAST("_raw" AS JSON), '$') ELSE NULL END) ILIKE ? ESCAPE '\', FALSE)) AND "host" = ? AND "status" >= ?

-- hot-only: service=api OR host!=web2
SELECT *
FROM (SELECT * REPLACE (TRY_CAST("_time" AS TIMESTAMP) AS "_time", TRY_CAST("_ingested" AS TIMESTAMP) AS "_ingested", TRY_CAST(json_extract_string(to_json("duration"), '$') AS DOUBLE) AS "duration", json_extract_string(to_json("host"), '$') AS "host", (CASE WHEN TRY_CAST(json_extract_string(to_json("status"), '$') AS DECIMAL(38,6)) = TRY_CAST(TRY_CAST(json_extract_string(to_json("status"), '$') AS BIGINT) AS DECIMAL(38,6)) THEN TRY_CAST(json_extract_string(to_json("status"), '$') AS BIGINT) END) AS "status") FROM read_json('<dir>/hot.ndjson', format='newline_delimited', records=true, auto_detect=true, field_appearance_threshold=0))
WHERE (("service" = ?) OR (("host" != ? OR "host" IS NULL)))

-- hot-only: earliest="2024-01-15T10:00:00Z" host=web*
SELECT *
FROM (SELECT * REPLACE (TRY_CAST("_time" AS TIMESTAMP) AS "_time", TRY_CAST("_ingested" AS TIMESTAMP) AS "_ingested", TRY_CAST(json_extract_string(to_json("duration"), '$') AS DOUBLE) AS "duration", json_extract_string(to_json("host"), '$') AS "host", (CASE WHEN TRY_CAST(json_extract_string(to_json("status"), '$') AS DECIMAL(38,6)) = TRY_CAST(TRY_CAST(json_extract_string(to_json("status"), '$') AS BIGINT) AS DECIMAL(38,6)) THEN TRY_CAST(json_extract_string(to_json("status"), '$') AS BIGINT) END) AS "status") FROM read_json('<dir>/hot.ndjson', format='newline_delimited', records=true, auto_detect=true, field_appearance_threshold=0))
WHERE TRY_CAST("_time" AS TIMESTAMP) >= CAST(? AS TIMESTAMP) AND "host" GLOB ?

-- hot-only: * | where status >= 500 and duration > 1.5
SELECT *
FROM (SELECT * REPLACE (TRY_CAST("_time" AS TIMESTAMP) AS "_time", TRY_CAST("_ingested" AS TIMESTAMP) AS "_ingested", TRY_CAST(json_extract_string(to_json("duration"), '$') AS DOUBLE) AS "duration", json_extract_string(to_json("host"), '$') AS "host", (CASE WHEN TRY_CAST(json_extract_string(to_json("status"), '$') AS DECIMAL(38,6)) = TRY_CAST(TRY_CAST(json_extract_string(to_json("status"), '$') AS BIGINT) AS DECIMAL(38,6)) THEN TRY_CAST(json_extract_string(to_json("status"), '$') AS BIGINT) END) AS "status") FROM read_json('<dir>/hot.ndjson', format='newline_delimited', records=true, auto_detect=true, field_appearance_threshold=0))
WHERE (("status" >= ?) AND ("duration" > ?))

-- hot-only: * | where lower(host) == "web1" or isnull(service)
SELECT *
FROM (SELECT * REPLACE (TRY_CAST("_time" AS TIMESTAMP) AS "_time", TRY_CAST("_ingested" AS TIMESTAMP) AS "_ingested", TRY_CAST(json_extract_string(to_json("duration"), '$') AS DOUBLE) AS "duration", json_extract_string(to_json("host"), '$') AS "host", (CASE WHEN TRY_CAST(json_extract_string(to_json("status"), '$') AS DECIMAL(38,6)) = TRY_CAST(TRY_CAST(json_extract_string(to_json("status"), '$') AS BIGINT) AS DECIMAL(38,6)) THEN TRY_CAST(json_extract_string(to_json("status"), '$') AS BIGINT) END) AS "status") FROM read_json('<dir>/hot.ndjson', format='newline_delimited', records=true, auto_detect=true, field_appearance_threshold=0))
WHERE ((LOWER("host") = ?) OR ("service" IS NULL))

-- hot-only: * | let slow = duration > 1.0, code = status * 2 | table host, slow, code
WITH _s0 AS (
  SELECT *
  FROM (SELECT * REPLACE (TRY_CAST("_time" AS TIMESTAMP) AS "_time", TRY_CAST("_ingested" AS TIMESTAMP) AS "_ingested", TRY_CAST(json_extract_string(to_json("duration"), '$') AS DOUBLE) AS "duration", json_extract_string(to_json("host"), '$') AS "host", (CASE WHEN TRY_CAST(json_extract_string(to_json("status"), '$') AS DECIMAL(38,6)) = TRY_CAST(TRY_CAST(json_extract_string(to_json("status"), '$') AS BIGINT) AS DECIMAL(38,6)) THEN TRY_CAST(json_extract_string(to_json("status"), '$') AS BIGINT) END) AS "status") FROM read_json('<dir>/hot.ndjson', format='newline_delimited', records=true, auto_detect=true, field_appearance_threshold=0))
), _s1 AS (
  SELECT COLUMNS(c -> translate(c, 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz') NOT IN ('slow', 'code')), (("duration" > ?)) AS "slow", (("status" * ?)) AS "code"
  FROM "_s0"
)
SELECT "host", "slow", "code"
FROM "_s1"

-- hot-only: host=web1 | table _time, host, status, message
SELECT "_time", "host", "status", "message"
FROM (SELECT * REPLACE (TRY_CAST("_time" AS TIMESTAMP) AS "_time", TRY_CAST("_ingested" AS TIMESTAMP) AS "_ingested", TRY_CAST(json_extract_string(to_json("duration"), '$') AS DOUBLE) AS "duration", json_extract_string(to_json("host"), '$') AS "host", (CASE WHEN TRY_CAST(json_extract_string(to_json("status"), '$') AS DECIMAL(38,6)) = TRY_CAST(TRY_CAST(json_extract_string(to_json("status"), '$') AS BIGINT) AS DECIMAL(38,6)) THEN TRY_CAST(json_extract_string(to_json("status"), '$') AS BIGINT) END) AS "status") FROM read_json('<dir>/hot.ndjson', format='newline_delimited', records=true, auto_detect=true, field_appearance_threshold=0))
WHERE "host" = ?

-- hot-only: * | fields host, status
SELECT "host", "status"
FROM (SELECT * REPLACE (TRY_CAST("_time" AS TIMESTAMP) AS "_time", TRY_CAST("_ingested" AS TIMESTAMP) AS "_ingested", TRY_CAST(json_extract_string(to_json("duration"), '$') AS DOUBLE) AS "duration", json_extract_string(to_json("host"), '$') AS "host", (CASE WHEN TRY_CAST(json_extract_string(to_json("status"), '$') AS DECIMAL(38,6)) = TRY_CAST(TRY_CAST(json_extract_string(to_json("status"), '$') AS BIGINT) AS DECIMAL(38,6)) THEN TRY_CAST(json_extract_string(to_json("status"), '$') AS BIGINT) END) AS "status") FROM read_json('<dir>/hot.ndjson', format='newline_delimited', records=true, auto_detect=true, field_appearance_threshold=0))

-- hot-only: * | rename host as server | table server, status
WITH _s0 AS (
  SELECT COLUMNS(c -> translate(c, 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz') NOT IN ('host', 'server')), "host" AS "server"
  FROM (SELECT * REPLACE (TRY_CAST("_time" AS TIMESTAMP) AS "_time", TRY_CAST("_ingested" AS TIMESTAMP) AS "_ingested", TRY_CAST(json_extract_string(to_json("duration"), '$') AS DOUBLE) AS "duration", json_extract_string(to_json("host"), '$') AS "host", (CASE WHEN TRY_CAST(json_extract_string(to_json("status"), '$') AS DECIMAL(38,6)) = TRY_CAST(TRY_CAST(json_extract_string(to_json("status"), '$') AS BIGINT) AS DECIMAL(38,6)) THEN TRY_CAST(json_extract_string(to_json("status"), '$') AS BIGINT) END) AS "status") FROM read_json('<dir>/hot.ndjson', format='newline_delimited', records=true, auto_detect=true, field_appearance_threshold=0))
)
SELECT "server", "status"
FROM "_s0"

-- hot-only: * | stats count() as n, avg(duration) as d by host
SELECT "host", COUNT(*) AS "n", AVG("duration") AS "d"
FROM (SELECT * REPLACE (TRY_CAST("_time" AS TIMESTAMP) AS "_time", TRY_CAST("_ingested" AS TIMESTAMP) AS "_ingested", TRY_CAST(json_extract_string(to_json("duration"), '$') AS DOUBLE) AS "duration", json_extract_string(to_json("host"), '$') AS "host", (CASE WHEN TRY_CAST(json_extract_string(to_json("status"), '$') AS DECIMAL(38,6)) = TRY_CAST(TRY_CAST(json_extract_string(to_json("status"), '$') AS BIGINT) AS DECIMAL(38,6)) THEN TRY_CAST(json_extract_string(to_json("status"), '$') AS BIGINT) END) AS "status") FROM read_json('<dir>/hot.ndjson', format='newline_delimited', records=true, auto_detect=true, field_appearance_threshold=0))
GROUP BY "host"

-- hot-only: * | timechart span=1h count() by host
SELECT time_bucket(INTERVAL '1 hours', TRY_CAST("_time" AS TIMESTAMP)) AS "_time", "host", COUNT(*) AS "count"
FROM (SELECT * REPLACE (TRY_CAST("_time" AS TIMESTAMP) AS "_time", TRY_CAST("_ingested" AS TIMESTAMP) AS "_ingested", TRY_CAST(json_extract_string(to_json("duration"), '$') AS DOUBLE) AS "duration", json_extract_string(to_json("host"), '$') AS "host", (CASE WHEN TRY_CAST(json_extract_string(to_json("status"), '$') AS DECIMAL(38,6)) = TRY_CAST(TRY_CAST(json_extract_string(to_json("status"), '$') AS BIGINT) AS DECIMAL(38,6)) THEN TRY_CAST(json_extract_string(to_json("status"), '$') AS BIGINT) END) AS "status") FROM read_json('<dir>/hot.ndjson', format='newline_delimited', records=true, auto_detect=true, field_appearance_threshold=0))
GROUP BY time_bucket(INTERVAL '1 hours', TRY_CAST("_time" AS TIMESTAMP)), "host"
ORDER BY time_bucket(INTERVAL '1 hours', TRY_CAST("_time" AS TIMESTAMP)) ASC

-- hot-only: * | pivot count() on service by host
WITH _s0 AS (
  SELECT *
  FROM (SELECT * REPLACE (TRY_CAST("_time" AS TIMESTAMP) AS "_time", TRY_CAST("_ingested" AS TIMESTAMP) AS "_ingested", TRY_CAST(json_extract_string(to_json("duration"), '$') AS DOUBLE) AS "duration", json_extract_string(to_json("host"), '$') AS "host", (CASE WHEN TRY_CAST(json_extract_string(to_json("status"), '$') AS DECIMAL(38,6)) = TRY_CAST(TRY_CAST(json_extract_string(to_json("status"), '$') AS BIGINT) AS DECIMAL(38,6)) THEN TRY_CAST(json_extract_string(to_json("status"), '$') AS BIGINT) END) AS "status") FROM read_json('<dir>/hot.ndjson', format='newline_delimited', records=true, auto_detect=true, field_appearance_threshold=0))
), _s1 AS (
  SELECT "service", "host"
  FROM "_s0"
)
PIVOT "_s1"
ON "service"
USING COUNT(*)
GROUP BY "host"

-- hot-only: * | dedup host | table host
WITH _s0 AS (
  SELECT *
  FROM (SELECT * REPLACE (TRY_CAST("_time" AS TIMESTAMP) AS "_time", TRY_CAST("_ingested" AS TIMESTAMP) AS "_ingested", TRY_CAST(json_extract_string(to_json("duration"), '$') AS DOUBLE) AS "duration", json_extract_string(to_json("host"), '$') AS "host", (CASE WHEN TRY_CAST(json_extract_string(to_json("status"), '$') AS DECIMAL(38,6)) = TRY_CAST(TRY_CAST(json_extract_string(to_json("status"), '$') AS BIGINT) AS DECIMAL(38,6)) THEN TRY_CAST(json_extract_string(to_json("status"), '$') AS BIGINT) END) AS "status") FROM read_json('<dir>/hot.ndjson', format='newline_delimited', records=true, auto_detect=true, field_appearance_threshold=0))
), _s1 AS (
  SELECT *, ROW_NUMBER() OVER (PARTITION BY "host" ORDER BY TRY_CAST("_time" AS TIMESTAMP) DESC) AS "_rn"
  FROM "_s0"
), _s2 AS (
  SELECT * EXCLUDE ("_rn")
  FROM "_s1"
  WHERE "_rn" = 1
)
SELECT "host"
FROM "_s2"

-- hot-only: * | sort -status, host | table host, status
SELECT "host", "status"
FROM (SELECT * REPLACE (TRY_CAST("_time" AS TIMESTAMP) AS "_time", TRY_CAST("_ingested" AS TIMESTAMP) AS "_ingested", TRY_CAST(json_extract_string(to_json("duration"), '$') AS DOUBLE) AS "duration", json_extract_string(to_json("host"), '$') AS "host", (CASE WHEN TRY_CAST(json_extract_string(to_json("status"), '$') AS DECIMAL(38,6)) = TRY_CAST(TRY_CAST(json_extract_string(to_json("status"), '$') AS BIGINT) AS DECIMAL(38,6)) THEN TRY_CAST(json_extract_string(to_json("status"), '$') AS BIGINT) END) AS "status") FROM read_json('<dir>/hot.ndjson', format='newline_delimited', records=true, auto_detect=true, field_appearance_threshold=0))
ORDER BY "status" DESC, "host" ASC

-- hot-only: * | top 2 host
WITH _s0 AS (
  SELECT "host", COUNT(*) AS "count"
  FROM (SELECT * REPLACE (TRY_CAST("_time" AS TIMESTAMP) AS "_time", TRY_CAST("_ingested" AS TIMESTAMP) AS "_ingested", TRY_CAST(json_extract_string(to_json("duration"), '$') AS DOUBLE) AS "duration", json_extract_string(to_json("host"), '$') AS "host", (CASE WHEN TRY_CAST(json_extract_string(to_json("status"), '$') AS DECIMAL(38,6)) = TRY_CAST(TRY_CAST(json_extract_string(to_json("status"), '$') AS BIGINT) AS DECIMAL(38,6)) THEN TRY_CAST(json_extract_string(to_json("status"), '$') AS BIGINT) END) AS "status") FROM read_json('<dir>/hot.ndjson', format='newline_delimited', records=true, auto_detect=true, field_appearance_threshold=0))
  GROUP BY "host"
)
SELECT *
FROM "_s0"
ORDER BY "count" DESC
LIMIT 2

-- hot-only: * | eventstats max(duration) as peak by host | where duration < peak
WITH _s0 AS (
  SELECT *
  FROM (SELECT * REPLACE (TRY_CAST("_time" AS TIMESTAMP) AS "_time", TRY_CAST("_ingested" AS TIMESTAMP) AS "_ingested", TRY_CAST(json_extract_string(to_json("duration"), '$') AS DOUBLE) AS "duration", json_extract_string(to_json("host"), '$') AS "host", (CASE WHEN TRY_CAST(json_extract_string(to_json("status"), '$') AS DECIMAL(38,6)) = TRY_CAST(TRY_CAST(json_extract_string(to_json("status"), '$') AS BIGINT) AS DECIMAL(38,6)) THEN TRY_CAST(json_extract_string(to_json("status"), '$') AS BIGINT) END) AS "status") FROM read_json('<dir>/hot.ndjson', format='newline_delimited', records=true, auto_detect=true, field_appearance_threshold=0))
), _s1 AS (
  SELECT COLUMNS(c -> translate(c, 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz') NOT IN ('peak')), MAX("duration") OVER (PARTITION BY "host") AS "peak"
  FROM "_s0"
)
SELECT *
FROM "_s1"
WHERE ("duration" < "peak")

-- hot-only: * | extract "user=(?P<who>[a-z]+)" from message | table who
WITH _s0 AS (
  SELECT *
  FROM (SELECT * REPLACE (TRY_CAST("_time" AS TIMESTAMP) AS "_time", TRY_CAST("_ingested" AS TIMESTAMP) AS "_ingested", TRY_CAST(json_extract_string(to_json("duration"), '$') AS DOUBLE) AS "duration", json_extract_string(to_json("host"), '$') AS "host", (CASE WHEN TRY_CAST(json_extract_string(to_json("status"), '$') AS DECIMAL(38,6)) = TRY_CAST(TRY_CAST(json_extract_string(to_json("status"), '$') AS BIGINT) AS DECIMAL(38,6)) THEN TRY_CAST(json_extract_string(to_json("status"), '$') AS BIGINT) END) AS "status") FROM read_json('<dir>/hot.ndjson', format='newline_delimited', records=true, auto_detect=true, field_appearance_threshold=0))
), _s1 AS (
  SELECT COLUMNS(c -> translate(c, 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz') NOT IN ('who')), regexp_extract("message", ?, ?::VARCHAR[]) AS "_extract"
  FROM "_s0"
), _s2 AS (
  SELECT * EXCLUDE ("_extract"), nullif(struct_extract("_extract", 'g1'), '') AS "who"
  FROM "_s1"
)
SELECT "who"
FROM "_s2"

-- hot-only: * | extract kv | stats count() by user
SELECT *
FROM (SELECT * REPLACE (TRY_CAST("_time" AS TIMESTAMP) AS "_time", TRY_CAST("_ingested" AS TIMESTAMP) AS "_ingested", TRY_CAST(json_extract_string(to_json("duration"), '$') AS DOUBLE) AS "duration", json_extract_string(to_json("host"), '$') AS "host", (CASE WHEN TRY_CAST(json_extract_string(to_json("status"), '$') AS DECIMAL(38,6)) = TRY_CAST(TRY_CAST(json_extract_string(to_json("status"), '$') AS BIGINT) AS DECIMAL(38,6)) THEN TRY_CAST(json_extract_string(to_json("status"), '$') AS BIGINT) END) AS "status") FROM read_json('<dir>/hot.ndjson', format='newline_delimited', records=true, auto_detect=true, field_appearance_threshold=0))
