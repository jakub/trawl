---
source: crates/fleet-core/src/emitter/mod.rs
expression: "emit_dsl(\"* | timechart span=1h count() by service\")"
---
SELECT time_bucket(INTERVAL '1 hours', CAST("timestamp" AS TIMESTAMP)) AS "_time", "service", COUNT(*) AS "count"
FROM read_parquet('/data/**/*.parquet')
GROUP BY "_time", "service"
ORDER BY "_time" ASC
