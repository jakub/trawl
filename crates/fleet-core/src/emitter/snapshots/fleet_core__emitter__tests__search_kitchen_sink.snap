---
source: crates/fleet-core/src/emitter/mod.rs
expression: "emit_dsl(r#\"service:nginx level:error last:2h \"connection refused\" -debug\"#)"
---
SELECT *
FROM read_parquet('/data/**/*.parquet')
WHERE "service" = ? AND "level" = ? AND CAST("timestamp" AS TIMESTAMP) >= now()::TIMESTAMP - INTERVAL '2 hours' AND "message" ILIKE ? AND "message" NOT ILIKE ?
---
params:
  0: 'nginx'
  1: 'error'
  2: '%connection refused%'
  3: '%debug%'
