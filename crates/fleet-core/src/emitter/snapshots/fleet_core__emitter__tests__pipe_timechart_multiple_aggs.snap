---
source: crates/fleet-core/src/emitter/mod.rs
expression: "emit_dsl(\"* | timechart span=5m count(), avg(duration) by service\")"
---
SELECT time_bucket(INTERVAL '5 minutes', CAST("timestamp" AS TIMESTAMP)) AS "_time", "service", COUNT(*) AS "count", AVG("duration") AS "avg_duration"
FROM read_parquet('/data/**/*.parquet')
GROUP BY "_time", "service"
ORDER BY "_time" ASC
