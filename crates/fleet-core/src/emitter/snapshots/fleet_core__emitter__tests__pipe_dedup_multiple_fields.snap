---
source: crates/fleet-core/src/emitter/mod.rs
expression: "emit_dsl(\"* | dedup host, service\")"
---
WITH _s0 AS (
  SELECT *
  FROM read_parquet('/data/**/*.parquet')
), _s1 AS (
  SELECT *, ROW_NUMBER() OVER (PARTITION BY "host", "service" ORDER BY "timestamp" DESC) AS "_rn"
  FROM "_s0"
)
SELECT * EXCLUDE ("_rn")
FROM "_s1"
WHERE "_rn" = 1
