FROM (SELECT * FROM read_parquet('/data/**/*.parquet', union_by_name=true) UNION ALL BY NAME SELECT * REPLACE (CAST("timestamp" AS TIMESTAMP) AS "timestamp") FROM read_json_auto('/tmp/hot_abc123.ndjson'))
WHERE "service" = ?
