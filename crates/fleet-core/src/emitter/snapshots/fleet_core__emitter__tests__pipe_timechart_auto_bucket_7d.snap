---
source: crates/fleet-core/src/emitter/mod.rs
expression: "emit_dsl(\"last:7d | timechart count()\")"
---
SELECT time_bucket(INTERVAL '1 hours', "timestamp") AS "_time", COUNT(*) AS "count"
FROM read_parquet('/data/**/*.parquet')
WHERE "timestamp" >= now()::TIMESTAMP - INTERVAL '7 days'
GROUP BY "_time"
ORDER BY "_time" ASC
