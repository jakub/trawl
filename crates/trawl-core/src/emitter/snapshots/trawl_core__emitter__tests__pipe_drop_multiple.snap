---
source: crates/trawl-core/src/emitter/mod.rs
expression: "emit_dsl(\"* | drop message, raw, src_ip\")"
---
SELECT COLUMNS(c -> translate(c, 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz') NOT IN ('message', 'raw', 'src_ip'))
FROM read_parquet('/data/**/*.parquet', union_by_name=true)
