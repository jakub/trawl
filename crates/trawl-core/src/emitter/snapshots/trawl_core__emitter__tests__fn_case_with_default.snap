---
source: crates/trawl-core/src/emitter/mod.rs
expression: "emit_dsl(r#\"* | let sev = case(status >= 500, \"server_error\", status >= 400, \"client_error\", \"ok\")\"#)"
---
WITH _s0 AS (
  SELECT *
  FROM read_parquet('/data/**/*.parquet', union_by_name=true)
)
SELECT COLUMNS(c -> translate(c, 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz') NOT IN ('sev')), (CASE WHEN ("status" >= ?) THEN ? WHEN ("status" >= ?) THEN ? ELSE ? END) AS "sev"
FROM "_s0"
---
params:
  0: 500
  1: 'server_error'
  2: 400
  3: 'client_error'
  4: 'ok'
