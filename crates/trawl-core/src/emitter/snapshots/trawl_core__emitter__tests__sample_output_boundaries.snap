=====

* | sample 5 | let x = id + 1
---
WITH _s0 AS (
  SELECT *
  FROM read_parquet('/data/**/*.parquet', union_by_name=true)
  USING SAMPLE 5 ROWS (reservoir)
), _s1 AS (
  SELECT *
  FROM "_s0"
)
SELECT COLUMNS(c -> translate(c, 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz') NOT IN ('x')), (("id" + ?)) AS "x"
FROM "_s1"
---
params:
  0: 1

=====

* | sample 5 | extract "k=(?P<k>\w+)" from message
---
WITH _s0 AS (
  SELECT *
  FROM read_parquet('/data/**/*.parquet', union_by_name=true)
  USING SAMPLE 5 ROWS (reservoir)
), _s1 AS (
  SELECT *
  FROM "_s0"
), _s2 AS (
  SELECT COLUMNS(c -> translate(c, 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz') NOT IN ('k')), regexp_extract("message", ?, ?::VARCHAR[]) AS "_extract"
  FROM "_s1"
)
SELECT * EXCLUDE ("_extract"), nullif(struct_extract("_extract", 'g1'), '') AS "k"
FROM "_s2"
---
params:
  0: 'k=(?P<k>\w+)'
  1: '[g1]'

=====

* | sample 5 | dedup service
---
WITH _s0 AS (
  SELECT *
  FROM read_parquet('/data/**/*.parquet', union_by_name=true)
  USING SAMPLE 5 ROWS (reservoir)
), _s1 AS (
  SELECT *
  FROM "_s0"
), _s2 AS (
  SELECT *, ROW_NUMBER() OVER (PARTITION BY "service" ORDER BY TRY_CAST("_time" AS TIMESTAMP) DESC) AS "_rn"
  FROM "_s1"
)
SELECT * EXCLUDE ("_rn")
FROM "_s2"
WHERE "_rn" = 1

=====

* | sample 5 | eventstats count() as n by service
---
WITH _s0 AS (
  SELECT *
  FROM read_parquet('/data/**/*.parquet', union_by_name=true)
  USING SAMPLE 5 ROWS (reservoir)
), _s1 AS (
  SELECT *
  FROM "_s0"
)
SELECT COLUMNS(c -> translate(c, 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz') NOT IN ('n')), COUNT(*) OVER (PARTITION BY "service") AS "n"
FROM "_s1"

=====

* | sample 5 | pivot count() on service
---
WITH _s0 AS (
  SELECT *
  FROM read_parquet('/data/**/*.parquet', union_by_name=true)
  USING SAMPLE 5 ROWS (reservoir)
), _s1 AS (
  SELECT *
  FROM "_s0"
), _s2 AS (
  SELECT "service"
  FROM "_s1"
)
PIVOT "_s2"
ON "service"
USING COUNT(*)
