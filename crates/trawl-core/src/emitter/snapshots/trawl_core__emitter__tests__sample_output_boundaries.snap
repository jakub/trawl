* | sample 5 | drop message
---
WITH _s0 AS (
  SELECT *
  FROM read_parquet('/data/**/*.parquet', union_by_name=true)
  USING SAMPLE 5 ROWS (reservoir)
)
SELECT COLUMNS(c -> translate(c, 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz') NOT IN ('message'))
FROM "_s0"

=====

* | sample 5 | rename service as svc
---
WITH _s0 AS (
  SELECT *
  FROM read_parquet('/data/**/*.parquet', union_by_name=true)
  USING SAMPLE 5 ROWS (reservoir)
)
SELECT COLUMNS(c -> translate(c, 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz') NOT IN ('service', 'svc')), "service" AS "svc"
FROM "_s0"

=====

* | sample 5 | stats count() as n
---
WITH _s0 AS (
  SELECT *
  FROM read_parquet('/data/**/*.parquet', union_by_name=true)
  USING SAMPLE 5 ROWS (reservoir)
)
SELECT COUNT(*) AS "n"
FROM "_s0"

=====

* | sample 5 | stats count() as n by service
---
WITH _s0 AS (
  SELECT *
  FROM read_parquet('/data/**/*.parquet', union_by_name=true)
  USING SAMPLE 5 ROWS (reservoir)
)
SELECT "service", COUNT(*) AS "n"
FROM "_s0"
GROUP BY "service"

=====

* | sample 5 | timechart span=1h count()
---
WITH _s0 AS (
  SELECT *
  FROM read_parquet('/data/**/*.parquet', union_by_name=true)
  USING SAMPLE 5 ROWS (reservoir)
)
SELECT time_bucket(INTERVAL '1 hours', TRY_CAST("_time" AS TIMESTAMP)) AS "_time", COUNT(*) AS "count"
FROM "_s0"
GROUP BY time_bucket(INTERVAL '1 hours', TRY_CAST("_time" AS TIMESTAMP))
ORDER BY time_bucket(INTERVAL '1 hours', TRY_CAST("_time" AS TIMESTAMP)) ASC

=====

* | sample 5 | top 10 service
---
WITH _s0 AS (
  SELECT *
  FROM read_parquet('/data/**/*.parquet', union_by_name=true)
  USING SAMPLE 5 ROWS (reservoir)
), _s1 AS (
  SELECT "service", COUNT(*) AS "count"
  FROM "_s0"
  GROUP BY "service"
)
SELECT *
FROM "_s1"
ORDER BY "count" DESC
LIMIT 10

