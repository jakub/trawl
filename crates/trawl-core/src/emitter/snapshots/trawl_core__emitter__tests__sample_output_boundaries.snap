---
source: crates/trawl-core/src/emitter/mod.rs
expression: "sample_boundary_snapshot(&[r#\"* | sample 5 | where service == \"a\"\"#,\n\"* | sample 5 | sort id\", \"* | sample 5 | head 2\", \"* | sample 5 | tail 2\",\n\"* | sample 5 | table id, service\", \"* | sample 5 | fields id\",\n\"* | sample 5 | drop message\", \"* | sample 5 | rename service as svc\",\n\"* | sample 5 | stats count() as n\",\n\"* | sample 5 | stats count() as n by service\",\n\"* | sample 5 | timechart span=1h count()\", \"* | sample 5 | top 10 service\",\n\"* | sample 5 | rare 10 service\", \"* | sample 5 | sample 2\",\n\"* | sample 5 | let x = id + 1\",\nr#\"* | sample 5 | extract \"k=(?P<k>\\w+)\" from message\"#,\n\"* | sample 5 | dedup service\",\n\"* | sample 5 | eventstats count() as n by service\",\n\"* | sample 5 | pivot count() on service\",])"
---
* | sample 5 | where service == "a"
---
WITH _s0 AS (
  SELECT *
  FROM read_parquet('/data/**/*.parquet', union_by_name=true)
  USING SAMPLE 5 ROWS (reservoir)
)
SELECT *
FROM "_s0"
WHERE ("service" = ?)
---
params:
  0: 'a'

=====

* | sample 5 | sort id
---
WITH _s0 AS (
  SELECT *
  FROM read_parquet('/data/**/*.parquet', union_by_name=true)
  USING SAMPLE 5 ROWS (reservoir)
)
SELECT *
FROM "_s0"
ORDER BY "id" ASC

