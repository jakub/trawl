---
source: crates/trawl-core/src/emitter/mod.rs
expression: "emit_dsl(r#\"service=nginx _severity=error last=2h \"connection refused\" -debug\"#)"
---
SELECT *
FROM read_parquet('/data/**/*.parquet', union_by_name=true)
WHERE TRY_CAST("_time" AS TIMESTAMP) >= now()::TIMESTAMP - INTERVAL '2 hours' AND "service" = ? AND "_severity" = ? AND (COALESCE("message" ILIKE ?, FALSE) OR COALESCE("_raw" ILIKE ?, FALSE)) AND (COALESCE("message" NOT ILIKE ?, TRUE) AND COALESCE("_raw" NOT ILIKE ?, TRUE))
---
params:
  0: 'nginx'
  1: 'error'
  2: '%connection refused%'
  3: '%connection refused%'
  4: '%debug%'
  5: '%debug%'
