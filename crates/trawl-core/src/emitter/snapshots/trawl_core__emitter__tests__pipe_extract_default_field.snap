---
source: crates/trawl-core/src/emitter/mod.rs
expression: "emit_dsl(r#\"* | extract \"(?P<method>[A-Z]+) (?P<path>/[^ ]+)\"\"#)"
---
WITH _s0 AS (
  SELECT *
  FROM read_parquet('/data/**/*.parquet', union_by_name=true)
), _s1 AS (
  SELECT COLUMNS(c -> translate(c, 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz') NOT IN ('method', 'path')), regexp_extract("message", ?, ?::VARCHAR[]) AS "_extract"
  FROM "_s0"
)
SELECT * EXCLUDE ("_extract"), nullif(struct_extract("_extract", 'g1'), '') AS "method", nullif(struct_extract("_extract", 'g2'), '') AS "path"
FROM "_s1"
---
params:
  0: '(?P<method>[A-Z]+) (?P<path>/[^ ]+)'
  1: '[g1, g2]'
