---
source: crates/trawl-core/src/emitter/mod.rs
expression: "emit_dsl(r#\"service=nginx | extract \"(?P<code>[0-9]{3})\" from message | where code == \"500\"\"#)"
---
WITH _s0 AS (
  SELECT *
  FROM read_parquet('/data/**/*.parquet', union_by_name=true)
  WHERE "service" = ?
), _s1 AS (
  SELECT COLUMNS(c -> translate(c, 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz') NOT IN ('code')), regexp_extract("message", ?, ?::VARCHAR[]) AS "_extract"
  FROM "_s0"
), _s2 AS (
  SELECT * EXCLUDE ("_extract"), nullif(struct_extract("_extract", 'g1'), '') AS "code"
  FROM "_s1"
)
SELECT *
FROM "_s2"
WHERE ("code" = ?)
---
params:
  0: 'nginx'
  1: '(?P<code>[0-9]{3})'
  2: '[g1]'
  3: '500'
