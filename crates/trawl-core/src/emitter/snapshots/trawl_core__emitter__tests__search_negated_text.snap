---
source: crates/trawl-core/src/emitter/mod.rs
expression: "emit_dsl(\"-debug\")"
---
SELECT *
FROM read_parquet('/data/**/*.parquet', union_by_name=true)
WHERE (NOT COALESCE((CASE WHEN typeof("message") = 'VARCHAR' THEN CAST("message" AS VARCHAR) WHEN typeof("message") = 'JSON' AND json_type(CAST("message" AS JSON)) = 'VARCHAR' THEN json_extract_string(CAST("message" AS JSON), '$') ELSE NULL END) ILIKE ?, FALSE) AND NOT COALESCE((CASE WHEN typeof("_raw") = 'VARCHAR' THEN CAST("_raw" AS VARCHAR) WHEN typeof("_raw") = 'JSON' AND json_type(CAST("_raw" AS JSON)) = 'VARCHAR' THEN json_extract_string(CAST("_raw" AS JSON), '$') ELSE NULL END) ILIKE ?, FALSE))
---
params:
  0: '%debug%'
  1: '%debug%'
