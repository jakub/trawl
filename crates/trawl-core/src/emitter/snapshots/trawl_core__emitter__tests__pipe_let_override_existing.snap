---
source: crates/trawl-core/src/emitter/mod.rs
expression: "emit_dsl(\"* | let message = lower(message)\")"
---
WITH _s0 AS (
  SELECT *
  FROM read_parquet('/data/**/*.parquet', union_by_name=true)
)
SELECT COLUMNS(c -> translate(c, 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz') NOT IN ('message')), (LOWER("message")) AS "message"
FROM "_s0"
