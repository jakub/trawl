---
source: crates/trawl-core/src/emitter/mod.rs
expression: "emit_dsl(\"service=nginx _severity=error OR service=postgres _severity=warn\")"
---
SELECT *
FROM read_parquet('/data/**/*.parquet', union_by_name=true)
WHERE (("service" = ? AND "_severity" = ?) OR ("service" = ? AND "_severity" = ?))
---
params:
  0: 'nginx'
  1: 'error'
  2: 'postgres'
  3: 'warn'
