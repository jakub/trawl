---
source: crates/trawl-core/src/emitter/mod.rs
expression: "emit_dsl(r#\"* | let age = date_diff(\"second\", timestamp, now())\"#)"
---
WITH _s0 AS (
  SELECT *
  FROM read_parquet('/data/**/*.parquet', union_by_name=true)
)
SELECT COLUMNS(c -> translate(c, 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz') NOT IN ('age')), (DATE_DIFF(?, "timestamp", CAST(? AS TIMESTAMP))) AS "age"
FROM "_s0"
---
params:
  0: 'second'
  1: TIMESTAMP '2026-02-03 04:05:06.789012'
