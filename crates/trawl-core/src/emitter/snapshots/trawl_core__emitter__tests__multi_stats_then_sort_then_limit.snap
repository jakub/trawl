---
source: crates/trawl-core/src/emitter/mod.rs
expression: "emit_dsl(\"service:nginx | stats count() by host | sort -count | limit 10\")"
---
WITH _s0 AS (
  SELECT "host", COUNT(*) AS "count"
  FROM read_parquet('/data/**/*.parquet', union_by_name=true)
  WHERE "service" = ?
  GROUP BY "host"
)
SELECT *
FROM "_s0"
ORDER BY "count" DESC
LIMIT 10
---
params:
  0: 'nginx'
