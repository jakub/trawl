---
source: crates/trawl-core/src/emitter/mod.rs
expression: "emit_dsl(\"* | rename service as svc, host as hostname\")"
---
SELECT COLUMNS(c -> translate(c, 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz') NOT IN ('service', 'svc', 'host', 'hostname')), "service" AS "svc", "host" AS "hostname"
FROM read_parquet('/data/**/*.parquet', union_by_name=true)
