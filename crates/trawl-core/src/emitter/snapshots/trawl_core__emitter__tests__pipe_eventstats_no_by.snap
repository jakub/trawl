---
source: crates/trawl-core/src/emitter/mod.rs
expression: "emit_dsl(\"* | eventstats count() as total\")"
---
WITH _s0 AS (
  SELECT *
  FROM read_parquet('/data/**/*.parquet', union_by_name=true)
)
SELECT COLUMNS(c -> translate(c, 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz') NOT IN ('total')), COUNT(*) OVER () AS "total"
FROM "_s0"
