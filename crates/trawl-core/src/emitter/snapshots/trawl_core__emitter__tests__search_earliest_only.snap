---
source: crates/trawl-core/src/emitter/mod.rs
expression: "emit_dsl(r#\"earliest=\"2026-03-14T00:00:00Z\" _severity=error\"#)"
---
SELECT *
FROM read_parquet('/data/**/*.parquet', union_by_name=true)
WHERE TRY_CAST("_time" AS TIMESTAMP) >= CAST(? AS TIMESTAMP) AND "_severity" = ?
---
params:
  0: '2026-03-14T00:00:00Z'
  1: 'error'
