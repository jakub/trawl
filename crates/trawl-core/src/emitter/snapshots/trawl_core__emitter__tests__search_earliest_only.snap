---
source: crates/trawl-core/src/emitter/mod.rs
expression: "emit_dsl(r#\"earliest=\"2026-03-14T00:00:00Z\" level=error\"#)"
---
SELECT *
FROM read_parquet('/data/**/*.parquet', union_by_name=true)
WHERE CAST("timestamp" AS TIMESTAMP) >= CAST(? AS TIMESTAMP) AND "level" = ?
---
params:
  0: '2026-03-14T00:00:00Z'
  1: 'error'
