---
source: crates/trawl-core/src/emitter/mod.rs
expression: "emit_dsl(\"* | timechart span=5m count(), avg(duration) by service\")"
---
SELECT time_bucket(INTERVAL '5 minutes', TRY_CAST("_time" AS TIMESTAMP)) AS "_time", "service", COUNT(*) AS "count", AVG("duration") AS "avg_duration"
FROM read_parquet('/data/**/*.parquet', union_by_name=true)
GROUP BY time_bucket(INTERVAL '5 minutes', TRY_CAST("_time" AS TIMESTAMP)), "service"
ORDER BY time_bucket(INTERVAL '5 minutes', TRY_CAST("_time" AS TIMESTAMP)) ASC
