# Environment overrides for trawl-web (session proxy)
# Uncomment and modify as needed.

# Tracing filter. The commented value below is the built-in default —
# trawl_web is the proxy's own target (session, origin, upstream, startup)
# and fleet_auth the shared session/origin primitives. Keep both when
# customizing, or proxy and auth failures become invisible. trawld's filter
# names neither target, so do not reuse it here.
# RUST_LOG=trawl_web=info,fleet_auth=info

# Skip TLS verification of the upstream trawld self-signed cert.
# trawl-web honours it only for a loopback upstream (127.0.0.0/8, ::1 or
# localhost) and refuses to start for any other upstream host, or when
# [web] upstream_ca_path is also set. To verify a remote trawld, set
# upstream_ca_path in trawld.toml instead.
# TRAWL_WEB_INSECURE_UPSTREAM=1
