[Unit]
Description=Trawl web session proxy
Documentation=https://github.com/jakub/trawl
After=network-online.target trawld.service
Wants=network-online.target trawld.service

[Service]
Type=simple
ExecStart=/usr/bin/trawl-web --config /etc/trawl/trawld.toml
User=trawl
Group=trawl
EnvironmentFile=-/etc/default/trawl-web

# State & logging — share trawld's state dir (read-only access to web.cookie).
StateDirectory=trawl
LogsDirectory=trawl
WorkingDirectory=/var/lib/trawl

# Restart policy
Restart=on-failure
RestartSec=5s

# Sandboxing
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/var/lib/trawl
ReadOnlyPaths=/etc/trawl

# The proxy runs as the same trawl user that owns the minidumps, and it needs
# /var/lib/trawl writable for the session cookie, so nothing else would stop it
# reading or replacing a dump. A minidump is a verbatim copy of trawld's memory:
# API tokens, the TLS private key, the postgres password. A browser-facing proxy
# has no business with any of it. This masks the one subdirectory; web.cookie and
# the rest of /var/lib/trawl stay reachable. On kubernetes the same separation
# comes for free, because the cores PVC only mounts into the trawld container.
# The path always exists (usr/lib/tmpfiles.d/trawl.conf, recreated at every
# boot), so this needs no `-` prefix and a missing directory is a loud failure
# rather than a silently dropped protection.
InaccessiblePaths=/var/lib/trawl/cores

RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
