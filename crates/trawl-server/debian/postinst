#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
  # create trawl system user/group from sysusers.d config
  systemd-sysusers trawl.conf 2>/dev/null || true

  # NOTE (ADR-0004 slice 3): trawld's app state (history, saved queries,
  # schedules, report runs) lives in a dedicated `trawl` postgres database,
  # auto-migrated at boot. Any leftover transitional sqlite file is
  # PRESERVED in place, never read, migrated, or deleted; a leftover [auth]
  # db_path in trawld.toml is a loud startup error (conffile upgrades keep
  # the old file — follow the cutover runbook in the docs).

  # Lock down the credential-bearing config files. Both can carry postgres
  # DSNs: trawld.toml holds [auth]/[storage] database_url, and
  # /etc/default/trawld is the documented home for the FLEET_DATABASE_URL /
  # TRAWL_DATABASE_URL overrides. cargo-deb installs them 0640 root:root;
  # chown them root:trawl so trawld (User/Group=trawl) can read its config
  # while no unprivileged local user can read the DSNs. systemd reads the
  # EnvironmentFile as root, so root:trawl suffices there too.
  if id trawl >/dev/null 2>&1; then
    for f in /etc/trawl/trawld.toml /etc/default/trawld; do
      if [ -f "$f" ]; then
        chown root:trawl "$f"
        chmod 0640 "$f"
      fi
    done
  fi

  # Create the crash-dump directory (disabled unless the operator drops in
  # crashdump.conf, but the trawl-owned directory must exist either way so
  # the drop-in has somewhere writable to point at). Refuse a symlink or a
  # pre-existing non-directory at the path: root creates and chowns this
  # directory, so a planted link would make `install -d -o trawl` chown
  # through it to an arbitrary target.
  if id trawl >/dev/null 2>&1; then
    if [ -L /var/lib/trawl/cores ] || { [ -e /var/lib/trawl/cores ] && [ ! -d /var/lib/trawl/cores ]; }; then
      echo "postinst: /var/lib/trawl/cores exists and is not a plain directory, refusing to chown through it" >&2
      exit 1
    fi
    install -d -o trawl -g trawl -m 0700 /var/lib/trawl/cores
  fi

  # Bootstrap the trawl-web session cookie key (32 random bytes).
  # Idempotent: only generated on first install; preserved across upgrades
  # so existing browser sessions survive. Stored on the trawl-owned state
  # directory so trawl-web.service can read it with its sandboxed uid.
  if [ ! -s /var/lib/trawl/web.cookie ]; then
    if id trawl >/dev/null 2>&1; then
      install -d -o trawl -g trawl -m 0750 /var/lib/trawl
      tmp="$(mktemp /var/lib/trawl/web.cookie.XXXXXX)"
      chmod 0400 "$tmp"
      chown trawl:trawl "$tmp"
      # `head -c` writes the first 32 bytes of /dev/urandom without printing.
      head -c 32 /dev/urandom > "$tmp"
      mv "$tmp" /var/lib/trawl/web.cookie
    fi
  fi
fi

#DEBHELPER#
