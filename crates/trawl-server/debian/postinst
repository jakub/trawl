#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
  # create trawl system user/group from sysusers.d config
  systemd-sysusers trawl.conf 2>/dev/null || true

  # Create /var/lib/trawl/cores, 0700 trawl:trawl, from the shipped
  # usr/lib/tmpfiles.d/trawl.conf. The directory exists on every install,
  # whether or not the operator enables capture, so the drop-in always has
  # somewhere writable to point at.
  #
  # systemd-tmpfiles instead of a check followed by `install -d`: it opens each
  # path component with O_NOFOLLOW and refuses to act through a symlink or on a
  # non-directory. A test-then-create pair here is a TOCTOU window. During an
  # upgrade the old trawld is still running as the trawl user, and it owns
  # /var/lib/trawl, so it can rename `cores` and drop a symlink in its place
  # between the test and the create. GNU `install -d` follows a symlink to a
  # directory and chowns the target, as root, to trawl:trawl.
  #
  # Runs after systemd-sysusers, which is what makes `trawl` resolvable. Gated
  # on the binary existing so a systemd-less chroot still configures, but NOT
  # swallowed: a systemd-tmpfiles that is present and fails is a real failure,
  # and an install that carries on past it leaves the drop-in pointing at a
  # directory nobody created.
  if command -v systemd-tmpfiles >/dev/null 2>&1; then
    systemd-tmpfiles --create trawl.conf
  fi

  # NOTE (ADR-0004 slice 3): trawld's app state (history, saved queries,
  # schedules, report runs) lives in a dedicated `trawl` postgres database,
  # auto-migrated at boot. Any leftover transitional sqlite file is
  # PRESERVED in place, never read, migrated, or deleted; a leftover [auth]
  # db_path in trawld.toml is a loud startup error (conffile upgrades keep
  # the old file — follow the cutover runbook in the docs).

  # Lock down the credential-bearing config files. Both can carry postgres
  # DSNs: trawld.toml holds [auth]/[storage] database_url, and
  # /etc/default/trawld is the documented home for the FLEET_DATABASE_URL /
  # TRAWL_DATABASE_URL overrides. cargo-deb installs them 0640 root:root;
  # chown them root:trawl so trawld (User/Group=trawl) can read its config
  # while no unprivileged local user can read the DSNs. systemd reads the
  # EnvironmentFile as root, so root:trawl suffices there too.
  if id trawl >/dev/null 2>&1; then
    for f in /etc/trawl/trawld.toml /etc/default/trawld; do
      if [ -f "$f" ]; then
        chown root:trawl "$f"
        chmod 0640 "$f"
      fi
    done
  fi

  # Bootstrap the trawl-web session cookie key (32 random bytes).
  # Idempotent: only generated on first install; preserved across upgrades
  # so existing browser sessions survive. Stored on the trawl-owned state
  # directory so trawl-web.service can read it with its sandboxed uid.
  if [ ! -s /var/lib/trawl/web.cookie ]; then
    if id trawl >/dev/null 2>&1; then
      install -d -o trawl -g trawl -m 0750 /var/lib/trawl
      tmp="$(mktemp /var/lib/trawl/web.cookie.XXXXXX)"
      chmod 0400 "$tmp"
      chown trawl:trawl "$tmp"
      # `head -c` writes the first 32 bytes of /dev/urandom without printing.
      head -c 32 /dev/urandom > "$tmp"
      mv "$tmp" /var/lib/trawl/web.cookie
    fi
  fi

  # The proxy runs as trawl-web and reads this key through its membership of the
  # trawl group, so the key has to be group-readable. Applied on every configure
  # rather than at generation time only: installs predating the user split left
  # it 0400 trawl:trawl, which the proxy's new uid cannot read, and the key is
  # deliberately preserved across upgrades so nothing else would fix it. The
  # trawl group has exactly one member besides trawl itself.
  if [ -f /var/lib/trawl/web.cookie ] && id trawl >/dev/null 2>&1; then
    chown trawl:trawl /var/lib/trawl/web.cookie
    chmod 0640 /var/lib/trawl/web.cookie
  fi
fi

#DEBHELPER#
