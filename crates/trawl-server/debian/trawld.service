[Unit]
Description=Trawl log collection and search daemon
Documentation=https://github.com/jakub/trawl
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/trawld --config /etc/trawl/trawld.toml --no-monitor
User=trawl
Group=trawl
EnvironmentFile=-/etc/default/trawld

# State & logging
StateDirectory=trawl
# trawl-web traverses this directory for web.cookie and tls/; systemd reapplies this on every start.
StateDirectoryMode=0750
LogsDirectory=trawl
# Only trawld writes logs; systemd reapplies this on every start, including upgrades.
LogsDirectoryMode=0700
WorkingDirectory=/var/lib/trawl

# Restart policy
Restart=on-failure
RestartSec=5s

# Resource ceilings (ADR-0056), the chart's limits. Worst-case resident memory
# at the defaults is about 6.1-6.6 GiB: the query database 2 GiB, two
# maintenance databases at 1 GiB, in-flight ingest bodies, argon2, the hot
# buffer and unaccounted RSS. MemoryMax is a ceiling, not a reservation: on a
# host with less RAM, the host runs out before the unit does. LimitNOFILE sets
# the hard descriptor limit; trawld raises its soft limit to it at startup and
# logs both.
LimitNOFILE=65536
MemoryMax=8G

# Sandboxing
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/trawl
ReadOnlyPaths=/etc/trawl

# DuckDB may need JIT — do NOT set MemoryDenyWriteExecute
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
