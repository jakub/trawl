[Unit]
Description=Trawl log collection and search daemon
Documentation=https://github.com/jakub/trawl
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/trawld --config /etc/trawl/trawld.toml --no-monitor
User=trawl
Group=trawl
EnvironmentFile=-/etc/default/trawld

# State & logging
StateDirectory=trawl
LogsDirectory=trawl
WorkingDirectory=/var/lib/trawl

# Restart policy
Restart=on-failure
RestartSec=5s

# Sandboxing
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/trawl
ReadOnlyPaths=/etc/trawl

# DuckDB may need JIT — do NOT set MemoryDenyWriteExecute
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
