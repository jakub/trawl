#!/usr/bin/env bash
# trawl local dev stack: trawld + trawl-web + trunk serve under mprocs.
# pass --with-coastwatch to also run coastwatch's web api + worker + SPA; in
# that mode trawl delegates the coastwatch service list to
# `../coastwatch/bin/dev --joined-mprocs` and merges the YAML it produces.
# run from anywhere — resolves repo root via git.
#
# trawld hard-requires two postgres DSNs since ADR-0004 slice 3: the fleet
# keystore (FLEET_DATABASE_URL) and the trawl app-state db
# (TRAWL_DATABASE_URL), both on the homelab cnpg dev cluster. resolution
# mirrors coastwatch/bin/dev: a set env var wins wholesale; otherwise creds
# come from 1password. point both vars at a local postgres to skip op.
#
# host/port overrides (all optional, all default to today's behaviour):
#
#   TRAWL_DEV_HOST         hostname the BROWSER uses. also becomes trunk's
#                          proxy backend authority, which trunk stamps as the
#                          Host header on /api/* — fleet-auth compares it to
#                          the request Origin, so these two must be the same
#                          name or login 403s. default trawl.fleet.localhost
#   TRAWL_DEV_BIND         address trawl-web binds, and an extra address for
#                          trunk when it isn't loopback. must be an address
#                          TRAWL_DEV_HOST resolves to, or a wildcard (0.0.0.0
#                          / ::), which binds every interface and replaces
#                          rather than adds to trunk's loopback addresses.
#                          default 127.0.0.1
#   TRAWL_DEV_SPA_PORT     trunk serve port. default 8081 (8080 is taken by
#                          code-server on the dev box)
#   TRAWL_DEV_WEB_PORT     trawl-web port. default 8090
#   TRAWL_DEV_SERVER_PORT  trawld port (loopback only — nothing but trawl-web
#                          talks to it). default: whatever trawld.toml says
#   TRAWL_DEV_LOGIN_URL    URL printed in the login pane, when the SPA is
#                          reached through something else (e.g. tailscale
#                          serve terminating TLS on :443)
#
# remote dev over tailscale, viewing from a phone/tablet — `tailscale serve
# --bg 8081` proxies https://<magicdns-name>/ to trunk on loopback, so only
# trawl-web needs a reachable bind:
#
#   TRAWL_DEV_HOST=fractal.reverse-manta.ts.net \
#   TRAWL_DEV_BIND=$(tailscale ip -4) \
#   TRAWL_DEV_LOGIN_URL=https://fractal.reverse-manta.ts.net/login bin/dev
#
# TLS from tailscale also keeps the session cookie's Secure attribute
# satisfied; plain http to a non-localhost host would silently drop it
# unless [web] allow_insecure_cookies is set in trawld.toml.
#
# remote dev over the plain LAN, every interface — TRAWL_DEV_HOST must be the
# name the OTHER machine types into its address bar, since trunk stamps it as
# the proxied Host and fleet-auth matches it against the browser's Origin:
#
#   TRAWL_DEV_HOST=fractal TRAWL_DEV_BIND=0.0.0.0 bin/dev
#
# then browse http://fractal:8081/login from the other machine (that name has
# to resolve on BOTH boxes — mDNS `fractal.local` or an /etc/hosts entry).
# This path is plain http on a non-loopback host, so it needs
# `[web] allow_insecure_cookies = true` in ~/.trawl/trawld.toml (the file
# both daemons actually read; config/trawld.toml in this repo is only a
# commented template) — otherwise login succeeds and the browser then
# silently drops the Secure session cookie.

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

die() { printf 'bin/dev: %s\n' "$*" >&2; exit 1; }

with_coastwatch=false
for arg in "$@"; do
    case "$arg" in
        --with-coastwatch) with_coastwatch=true ;;
        *) die "unknown flag: $arg" ;;
    esac
done

command -v mprocs >/dev/null || die "mprocs not found. install with 'cargo install mprocs' or 'brew install mprocs'."
command -v trunk  >/dev/null || die "trunk not found. install with 'cargo install --locked trunk'."
command -v openssl >/dev/null || die "openssl not found."

# Dev SPA must be reached via the .fleet.localhost host, NOT 127.0.0.1: trunk's
# proxy stamps its backend authority (trawl.fleet.localhost:8090, Trunk.toml)
# as the Host header on proxied /api/* requests, and fleet-auth's present-only
# Origin guard compares Origin host against it — a 127.0.0.1 origin mismatches
# and login/logout 403. Mirrors coastwatch/bin/dev; requires a
# `127.0.0.1 trawl.fleet.localhost` resolver entry (checked below).
default_dev_host="trawl.fleet.localhost"
default_dev_bind="127.0.0.1"
# Must match Trunk.toml's `[serve] port`: the trunk invocation below only
# passes --port when spa_port differs from this default.
default_spa_port="8081"
default_web_port="8090"

dev_host="${TRAWL_DEV_HOST:-$default_dev_host}"
dev_bind="${TRAWL_DEV_BIND:-$default_dev_bind}"
spa_port="${TRAWL_DEV_SPA_PORT:-$default_spa_port}"
web_port="${TRAWL_DEV_WEB_PORT:-$default_web_port}"
dev_login_url="${TRAWL_DEV_LOGIN_URL:-http://${dev_host}:${spa_port}/login}"

# Resolve a hostname to its addresses, one per line. Portable across Linux
# (getent) and macOS (dscacheutil); prints nothing when neither resolver
# exists so the caller warns rather than blocks.
host_addresses() {
    local host="$1"
    if command -v getent >/dev/null 2>&1; then
        getent hosts "$host" 2>/dev/null | awk '{print $1}'
    elif command -v dscacheutil >/dev/null 2>&1; then
        dscacheutil -q host -a name "$host" 2>/dev/null \
            | awk -F': ' '/^ipv?6?_address/ {print $2}'
    fi
}

# `|| true`: an unresolvable host makes getent exit non-zero, which under
# `set -o pipefail` would abort the script — precisely the case these
# warnings exist to explain.
dev_addrs="$(host_addresses "$dev_host" || true)"

if [[ "$dev_host" == "$default_dev_host" ]]; then
    if [[ "$dev_addrs" != *127.0.0.1* && "$dev_addrs" != *::1* ]]; then
        printf 'bin/dev: WARNING — %s does not resolve to loopback.\n' "$dev_host" >&2
        printf '  trunk proxies /api/* to this host and fleet-auth rejects logins whose\n' >&2
        printf '  Origin host differs from it, so the SPA 403s. add the hosts entry, then\n' >&2
        printf '  open %s:\n' "$dev_login_url" >&2
        # leading \n guards against a hosts file with no trailing newline —
        # a bare append glues the entry onto the last line and breaks BOTH.
        printf "    printf '\\\\n127.0.0.1 %s\\\\n' | sudo tee -a /etc/hosts\n" "$dev_host" >&2
    fi
elif [[ -z "$dev_addrs" ]]; then
    printf 'bin/dev: WARNING — TRAWL_DEV_HOST=%s does not resolve.\n' "$dev_host" >&2
    printf '  trunk proxies /api/* to it, so every authenticated request will fail.\n' >&2
elif [[ "$dev_bind" != "0.0.0.0" && "$dev_bind" != "::" && "$dev_addrs" != *"$dev_bind"* ]]; then
    # The proxy hop is host-based (it must be, for the Origin check), so
    # binding trawl-web somewhere that hostname doesn't point at yields a
    # connection-refused on /api/* with an otherwise healthy-looking stack.
    printf 'bin/dev: WARNING — TRAWL_DEV_BIND=%s is not an address %s resolves to (%s).\n' \
        "$dev_bind" "$dev_host" "$(printf '%s' "$dev_addrs" | tr '\n' ' ')" >&2
    printf '  trunk proxies /api/* to %s:%s and will get connection refused.\n' \
        "$dev_host" "$web_port" >&2
fi

# trawld serves HTTPS with an auto-generated self-signed cert in dev, so the
# proxy's upstream client has no chain to verify and every /api/* call fails
# TLS verification without this. Dev-only escape hatch — the debian/helm units
# never set it. `${VAR-1}` (not `:-`) so an explicitly empty value still turns
# it off, matching how trawl-web reads the var.
export TRAWL_WEB_INSECURE_UPSTREAM="${TRAWL_WEB_INSECURE_UPSTREAM-1}"

# --- listener overrides ------------------------------------------------------
# Exported only when the knob was actually set, so an unset run leaves both
# binaries reading trawld.toml exactly as they did before these existed.
if [[ -n "${TRAWL_DEV_BIND:-}" || -n "${TRAWL_DEV_WEB_PORT:-}" ]]; then
    export TRAWL_WEB_BIND_ADDR="${dev_bind}:${web_port}"
fi
if [[ -n "${TRAWL_DEV_SERVER_PORT:-}" ]]; then
    # trawld stays on loopback whatever TRAWL_DEV_BIND says — nothing but
    # trawl-web talks to it, and trawl-web resolves its upstream through this
    # same variable, so the two can't drift apart.
    export TRAWL_HTTP_ADDR="127.0.0.1:${TRAWL_DEV_SERVER_PORT}"
fi

cookie_file="${HOME}/.trawl/dev-cookie-secret"
if [[ -z "${TRAWL_COOKIE_SECRET:-}" ]]; then
    if [[ -s "$cookie_file" ]]; then
        TRAWL_COOKIE_SECRET="$(<"$cookie_file")"
    else
        mkdir -p "${HOME}/.trawl"
        umask 077
        TRAWL_COOKIE_SECRET="$(openssl rand -base64 32)"
        printf '%s' "$TRAWL_COOKIE_SECRET" > "$cookie_file"
        chmod 600 "$cookie_file"
        printf 'bin/dev: generated %s\n' "$cookie_file"
    fi
fi
export TRAWL_COOKIE_SECRET

# --- cnpg dev databases (ADR-0004) ------------------------------------------
# DSNs assemble from the op items the homelab repo provisions
# (`CNPG fleet_dev`, `CNPG trawl_dev`, same convention as coastwatch's
# config registry). op-generated passwords carry URL-hostile symbols, so
# both userinfo parts are percent-encoded via jq before entering the DSN.
cnpg_host="postgres.lab.ktle.net:5432"

dsn_from_op() {
    local item="$1" db="$2" user pass
    user="$(op read "op://Homelab/CNPG ${item}/username")" \
        || die "op read failed for 'CNPG ${item}' username"
    pass="$(op read "op://Homelab/CNPG ${item}/password")" \
        || die "op read failed for 'CNPG ${item}' password"
    printf 'postgres://%s:%s@%s/%s' \
        "$(jq -rn --arg v "$user" '$v|@uri')" \
        "$(jq -rn --arg v "$pass" '$v|@uri')" \
        "$cnpg_host" "$db"
}

if [[ -z "${FLEET_DATABASE_URL:-}" || -z "${TRAWL_DATABASE_URL:-}" ]]; then
    command -v op >/dev/null || die "1password cli (op) not found — https://developer.1password.com/docs/cli/get-started/"
    command -v jq >/dev/null || die "jq not found (url-encodes db creds). install it via your package manager."
    # Two auth paths satisfy this gate. The desktop app integration prompts for
    # biometrics on the local session, so it is unusable over ssh — headless
    # shells want a service account token scoped to the Homelab vault instead.
    op whoami >/dev/null 2>&1 || die "1password cli not authenticated — run 'op signin' on a desktop session, or export OP_SERVICE_ACCOUNT_TOKEN for headless/ssh use (https://developer.1password.com/docs/service-accounts/)"
fi
[[ -n "${FLEET_DATABASE_URL:-}" ]] || FLEET_DATABASE_URL="$(dsn_from_op fleet_dev fleet_dev)"
[[ -n "${TRAWL_DATABASE_URL:-}" ]] || TRAWL_DATABASE_URL="$(dsn_from_op trawl_dev trawl_dev)"
export FLEET_DATABASE_URL TRAWL_DATABASE_URL

coastwatch_dir="$repo_root/../coastwatch"

printf 'bin/dev: building trawl bins...\n'
cargo build -p trawl-server -p trawl-web -p fleet-admin

# fleet-admin owns the bare DATABASE_URL variable (trawld never reads it) —
# scope it per invocation rather than exporting. migrate is idempotent;
# trawld boot-migrates the trawl app-state db itself, so fleet is the only
# schema handled here.
printf 'bin/dev: applying fleet-auth migrations to fleet_dev...\n'
DATABASE_URL="$FLEET_DATABASE_URL" cargo run -q -p fleet-admin -- migrate \
    || die "fleet-admin migrate failed — cnpg dev reachable?"

# Bootstrap a dev api key for the SPA login form and CLI. Mirrors
# coastwatch/bin/dev's ~/.coastwatch/dev-api-key: persisted under $HOME so
# it survives `cargo clean` and never touches the working tree. Held via
# the trawl-admin role (not analyst) so the one dev key also reaches the
# admin-only dashboard route.
dev_key_file="${HOME}/.trawl/dev-api-key"
dev_role="trawl-admin"
if [[ ! -s "$dev_key_file" ]]; then
    # Roles are data-defined since ADR-0006 slice 1 and `keys create --role`
    # refuses names that don't exist, so the tier has to be there first. A
    # converted fleet db already has trawl-admin (the migration lifts legacy
    # grants into roles); a fresh one has no roles at all. `roles show` is
    # the idempotence probe — `roles create` errors with RoleExists.
    if ! DATABASE_URL="$FLEET_DATABASE_URL" cargo run -q -p fleet-admin -- \
        roles show "$dev_role" >/dev/null 2>&1
    then
        printf 'bin/dev: creating %s role via fleet-admin...\n' "$dev_role"
        DATABASE_URL="$FLEET_DATABASE_URL" cargo run -q -p fleet-admin -- \
            roles create --name "$dev_role" \
            --perm trawl:query --perm trawl:schema_read --perm trawl:validate \
            --perm trawl:saved_query --perm trawl:export --perm trawl:stream \
            --perm trawl:query_cancel --perm trawl:server_manage \
            || die "fleet-admin roles create failed"
    fi

    printf 'bin/dev: minting dev api key via fleet-admin (human/%s)...\n' "$dev_role"
    minted=$(DATABASE_URL="$FLEET_DATABASE_URL" cargo run -q -p fleet-admin -- \
        keys create --name "trawl-dev-$(whoami)" --kind human --role "$dev_role") \
        || die "fleet-admin keys create failed"
    mkdir -p "${HOME}/.trawl"
    umask 077
    printf '%s' "$minted" > "$dev_key_file"
    chmod 600 "$dev_key_file"
    printf 'bin/dev: stored dev api key at %s\n' "$dev_key_file"
fi

emit_procs_yaml() {
    cat <<YAML
procs:
  trawld:
    shell: cargo run -p trawl-server --bin trawld
  trawl-web:
    shell: cargo run -p trawl-web
  trunk:
    shell: ${trunk_cmd}
    cwd: crates/trawl-web-ui
YAML
    # `exec mprocs` enters the alternate screen and wipes pre-launch output,
    # so surface the login token as a self-exiting info pane. The token is
    # read from the cache file when the pane launches — never baked into
    # this yaml (which lands in a mktemp file).
    if [[ -s "$dev_key_file" ]]; then
        cat <<YAML
  trawl-login:
    shell: echo "paste this api key into ${dev_login_url}:"; echo; cat "${dev_key_file}"
YAML
    fi
}

cleanup_paths=()
cleanup() {
    for p in "${cleanup_paths[@]}"; do
        [[ -n "$p" && -e "$p" ]] && rm -rf "$p"
    done
}
trap cleanup EXIT

# --- trunk invocation --------------------------------------------------------
# Port and address ARE overridable from the command line (--address replaces
# the config's list rather than adding to it), but the proxy backend is not:
# TRUNK_SERVE_PROXY_BACKEND / --proxy-backend register a SECOND proxy
# alongside Trunk.toml's `[[proxy]]`, and trunk panics on the duplicate
# `/api/` route. Changing the backend therefore means handing trunk a
# rewritten copy of the config — which has to sit beside the original, since
# trunk resolves `target`/`dist` relative to the config file's directory.
trunk_cmd="trunk serve"
trunk_backend="http://${dev_host}:${web_port}/api/"

if [[ "$trunk_backend" != "http://${default_dev_host}:${default_web_port}/api/" ]]; then
    generated_trunk_config="$repo_root/crates/trawl-web-ui/.Trunk.dev.toml"
    sed "s|^backend = .*|backend = \"${trunk_backend}\"|" \
        "$repo_root/crates/trawl-web-ui/Trunk.toml" > "$generated_trunk_config"
    cleanup_paths+=("$generated_trunk_config")
    trunk_cmd+=" --config .Trunk.dev.toml"
    printf 'bin/dev: trunk proxies /api/* -> %s\n' "$trunk_backend"
fi

if [[ "$spa_port" != "$default_spa_port" ]]; then
    trunk_cmd+=" --port $spa_port"
fi

if [[ "$dev_bind" != "$default_dev_bind" ]]; then
    # --address REPLACES Trunk.toml's list, so re-state both loopback
    # families: a local browser and `tailscale serve` both arrive that way.
    #
    # Except for wildcards. A wildcard already covers loopback, and the
    # kernel refuses the overlapping bind — 0.0.0.0:PORT after 127.0.0.1:PORT
    # is EADDRINUSE even with SO_REUSEADDR — so re-stating loopback here
    # would abort trunk on startup rather than widen it.
    case "$dev_bind" in
        0.0.0.0|::) trunk_cmd+=" --address $dev_bind" ;;
        *)          trunk_cmd+=" --address 127.0.0.1 --address ::1 --address $dev_bind" ;;
    esac
fi

# Two hard constraints collide on the config filename: BSD mktemp only
# substitutes trailing Xs (no suffix after them), while mprocs rejects any
# config without a lua/yaml/yml/json extension. A temp dir satisfies both.
mprocs_dir="$(mktemp -d "${TMPDIR:-/tmp}/trawl-dev-mprocs.XXXXXX")"
cleanup_paths+=("$mprocs_dir")
mprocs_config="$mprocs_dir/mprocs.yaml"
emit_procs_yaml > "$mprocs_config"

if $with_coastwatch; then
    [[ -d "$coastwatch_dir" ]] || die "coastwatch repo not found at $coastwatch_dir"
    [[ -x "$coastwatch_dir/bin/dev" ]] || die "$coastwatch_dir/bin/dev missing or not executable"

    printf 'bin/dev: delegating coastwatch service config to coastwatch/bin/dev...\n'
    coastwatch_yaml="$("$coastwatch_dir/bin/dev" --joined-mprocs)" \
        || die "coastwatch/bin/dev --joined-mprocs failed"
    cleanup_paths+=("$coastwatch_yaml")

    # coastwatch emits a self-contained mprocs config with its own `procs:`
    # header — strip that header line, then append the body under trawl's.
    awk '!/^procs:[[:space:]]*$/' "$coastwatch_yaml" >> "$mprocs_config"
fi

exec mprocs --config "$mprocs_config"
