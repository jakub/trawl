#!/usr/bin/env bash
# trawl local dev stack: trawld + trawl-web + trunk serve under mprocs.
# pass --with-coastwatch to also run coastwatch's api + ingest + worker; in
# that mode trawl delegates the coastwatch service list to
# `../coastwatch/bin/dev --joined-mprocs` and merges the YAML it produces.
# run from anywhere — resolves repo root via git.

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

die() { printf 'bin/dev: %s\n' "$*" >&2; exit 1; }

with_coastwatch=false
for arg in "$@"; do
    case "$arg" in
        --with-coastwatch) with_coastwatch=true ;;
        *) die "unknown flag: $arg" ;;
    esac
done

command -v mprocs >/dev/null || die "mprocs not found. install with 'cargo install mprocs' or 'brew install mprocs'."
command -v trunk  >/dev/null || die "trunk not found. install with 'cargo install --locked trunk'."
command -v openssl >/dev/null || die "openssl not found."

cookie_file="${HOME}/.trawl/dev-cookie-secret"
if [[ -z "${TRAWL_COOKIE_SECRET:-}" ]]; then
    if [[ -s "$cookie_file" ]]; then
        TRAWL_COOKIE_SECRET="$(<"$cookie_file")"
    else
        mkdir -p "${HOME}/.trawl"
        umask 077
        TRAWL_COOKIE_SECRET="$(openssl rand -base64 32)"
        printf '%s' "$TRAWL_COOKIE_SECRET" > "$cookie_file"
        chmod 600 "$cookie_file"
        printf 'bin/dev: generated %s\n' "$cookie_file"
    fi
fi
export TRAWL_COOKIE_SECRET

coastwatch_dir="$repo_root/../coastwatch"

printf 'bin/dev: building trawl bins...\n'
cargo build -p trawl-server -p trawl-web

mprocs_config="$repo_root/mprocs.yaml"
cleanup_paths=()
cleanup() {
    for p in "${cleanup_paths[@]}"; do
        [[ -n "$p" && -f "$p" ]] && rm -f "$p"
    done
}
trap cleanup EXIT

if $with_coastwatch; then
    [[ -d "$coastwatch_dir" ]] || die "coastwatch repo not found at $coastwatch_dir"
    [[ -x "$coastwatch_dir/bin/dev" ]] || die "$coastwatch_dir/bin/dev missing or not executable"

    printf 'bin/dev: delegating coastwatch service config to coastwatch/bin/dev...\n'
    coastwatch_yaml="$("$coastwatch_dir/bin/dev" --joined-mprocs)" \
        || die "coastwatch/bin/dev --joined-mprocs failed"
    cleanup_paths+=("$coastwatch_yaml")

    merged="$(mktemp "${TMPDIR:-/tmp}/trawl-dev-mprocs.XXXXXX.yaml")"
    cleanup_paths+=("$merged")

    # merge trawl's procs and coastwatch's procs under a single `procs:` key.
    # coastwatch emits a self-contained mprocs config with its own `procs:`
    # header — strip that header line, then append the body under trawl's.
    cat > "$merged" <<YAML
procs:
  trawld:
    shell: cargo run -p trawl-server --bin trawld
  trawl-web:
    shell: cargo run -p trawl-web
  trunk:
    shell: trunk serve
    cwd: crates/trawl-web-ui
YAML
    awk '!/^procs:[[:space:]]*$/' "$coastwatch_yaml" >> "$merged"
    mprocs_config="$merged"
fi

exec mprocs --config "$mprocs_config"
