#!/usr/bin/env bash
# Thin compatibility wrapper for the Trawl-owned Fleet development controller.
#
# Frozen legacy translations:
#   bin/dev                    -> fleet-dev dev trawl --app-root <trawl-root>
#   bin/dev --with-coastwatch  -> fleet-dev all
#   bin/dev --tailscale        -> add --exposure tailscale
#   bin/dev --release-spa      -> add --release-spa

set -euo pipefail

script_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"
trawl_root="$(CDPATH= cd -- "$script_dir/.." && pwd -P)"

with_coastwatch=false
tailscale=false
release_spa=false
for argument in "$@"; do
    case "$argument" in
        --with-coastwatch) with_coastwatch=true ;;
        --tailscale) tailscale=true ;;
        --release-spa) release_spa=true ;;
        *)
            printf 'bin/dev: unknown flag: %s\n' "$argument" >&2
            exit 2
            ;;
    esac
done

global=()
if $tailscale; then
    global+=(--exposure tailscale)
fi

if $with_coastwatch; then
    command=(all)
else
    command=(dev trawl --app-root "$trawl_root")
fi
if $release_spa; then
    command+=(--release-spa)
fi

exec "$trawl_root/bin/fleet-dev" "${global[@]}" "${command[@]}"
