{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "secretName",
        "certManager"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "auto",
            "secret",
            "certManager"
          ]
        },
        "secretName": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
        },
        "certManager": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "issuerRef",
            "dnsNames"
          ],
          "properties": {
            "issuerRef": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "kind",
                "group"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 253,
                  "pattern": "^$|^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "Issuer",
                    "ClusterIssuer"
                  ]
                },
                "group": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253,
                  "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
                }
              }
            },
            "dnsNames": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253,
                "pattern": "^(\\*\\.)?[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$"
              }
            }
          }
        }
      }
    },
    "prometheusRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "namespace",
        "additionalLabels",
        "alerts"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "namespace": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "additionalLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "alerts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "TrawlSyslogQueueDiscard",
            "TrawlSyslogWalDiscard",
            "TrawlTelemetryCapacityDiscard",
            "TrawlSyslogWriteOutcomeUncertain",
            "TrawlTelemetryWriteOutcomeUncertain",
            "TrawlHttpPersistenceRejection",
            "TrawlTelemetryWalWriteFailure",
            "TrawlWalDurabilityDegraded",
            "TrawlCompactionOperationFailure",
            "TrawlFileQuarantine"
          ],
          "properties": {
            "TrawlSyslogQueueDiscard": {
              "$ref": "#/definitions/operationalAlert"
            },
            "TrawlSyslogWalDiscard": {
              "$ref": "#/definitions/operationalAlert"
            },
            "TrawlTelemetryCapacityDiscard": {
              "$ref": "#/definitions/operationalAlert"
            },
            "TrawlSyslogWriteOutcomeUncertain": {
              "$ref": "#/definitions/operationalAlert"
            },
            "TrawlTelemetryWriteOutcomeUncertain": {
              "$ref": "#/definitions/operationalAlert"
            },
            "TrawlHttpPersistenceRejection": {
              "$ref": "#/definitions/operationalAlert"
            },
            "TrawlTelemetryWalWriteFailure": {
              "$ref": "#/definitions/operationalAlert"
            },
            "TrawlWalDurabilityDegraded": {
              "$ref": "#/definitions/operationalAlert"
            },
            "TrawlCompactionOperationFailure": {
              "$ref": "#/definitions/operationalAlert"
            },
            "TrawlFileQuarantine": {
              "$ref": "#/definitions/operationalAlert"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "operationalAlert": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "severity"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "severity": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*",
          "not": {
            "pattern": "\\{\\{|\\}\\}"
          }
        }
      }
    }
  }
}
