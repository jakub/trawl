{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "secretName",
        "certManager"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "auto",
            "secret",
            "certManager"
          ]
        },
        "secretName": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
        },
        "certManager": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "issuerRef",
            "dnsNames"
          ],
          "properties": {
            "issuerRef": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "kind",
                "group"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 253,
                  "pattern": "^$|^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "Issuer",
                    "ClusterIssuer"
                  ]
                },
                "group": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253,
                  "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
                }
              }
            },
            "dnsNames": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253,
                "pattern": "^(\\*\\.)?[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$"
              }
            }
          }
        }
      }
    }
  }
}
