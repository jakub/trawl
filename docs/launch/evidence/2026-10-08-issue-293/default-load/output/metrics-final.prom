# HELP trawl_hot_buffer_admission_refusals_total Hot-buffer reservations refused, labelled by producer (http, syslog, trawld) and kind (full = no free space, retry after compaction drains; oversized = larger than the producer's ceiling, can never fit)
# TYPE trawl_hot_buffer_admission_refusals_total counter
trawl_hot_buffer_admission_refusals_total{producer="syslog",kind="full"} 0
trawl_hot_buffer_admission_refusals_total{producer="syslog",kind="oversized"} 0
trawl_hot_buffer_admission_refusals_total{producer="trawld",kind="full"} 0
trawl_hot_buffer_admission_refusals_total{producer="http",kind="oversized"} 0
trawl_hot_buffer_admission_refusals_total{producer="trawld",kind="oversized"} 0
trawl_hot_buffer_admission_refusals_total{producer="http",kind="full"} 153
# HELP trawl_hot_buffer_duplicate_batches_total Hot-buffer batches dropped because their batch id was already resident; the resident batch is kept. Nonzero means a WAL writer bug
# TYPE trawl_hot_buffer_duplicate_batches_total counter
trawl_hot_buffer_duplicate_batches_total 0
# HELP trawl_http_requests_refused_total HTTP requests refused with 503 request_limit_reached because their allowance had no request in progress free, by allowance
# TYPE trawl_http_requests_refused_total counter
trawl_http_requests_refused_total{allowance="control"} 0
trawl_http_requests_refused_total{allowance="regular"} 0
# HELP trawl_ingest_events_total Total number of ingested events
# TYPE trawl_ingest_events_total counter
trawl_ingest_events_total 446220
# HELP trawl_hot_buffer_oldest_batch_age_seconds Age in seconds of the oldest resident hot-buffer batch (a batch reloaded from the WAL at boot counts from its file's timestamp), 0 when the buffer is empty; rising past a few compaction intervals means compaction is not draining
# TYPE trawl_hot_buffer_oldest_batch_age_seconds gauge
trawl_hot_buffer_oldest_batch_age_seconds 23.098419405
# HELP trawl_hot_buffer_admission_state Hot-buffer admission state: 0 = open, 1 = pressure (at or above half of either cap, compaction drains early), 2 = refusing (a reservation was refused for lack of space; clears below a quarter of both caps)
# TYPE trawl_hot_buffer_admission_state gauge
trawl_hot_buffer_admission_state 0
# HELP trawl_http_request_allowance Size of each request allowance: server.max_concurrent_requests for regular, the fixed control allowance for control
# TYPE trawl_http_request_allowance gauge
trawl_http_request_allowance{allowance="regular"} 32
trawl_http_request_allowance{allowance="control"} 4
# HELP trawl_hot_buffer_max_bytes Hot-buffer serialized-byte cap (ingest.hot_buffer_max_bytes); external producers may fill 15/16 of it, self-telemetry all of it
# TYPE trawl_hot_buffer_max_bytes gauge
trawl_hot_buffer_max_bytes 104857600
# HELP trawl_hot_buffer_max_events Hot-buffer event cap (ingest.hot_buffer_max_events); external producers may fill 15/16 of it, self-telemetry all of it
# TYPE trawl_hot_buffer_max_events gauge
trawl_hot_buffer_max_events 100000
# HELP trawl_http_requests_in_progress HTTP requests in progress, by allowance (regular: server.max_concurrent_requests; control: health, metrics and query listing and cancellation). Ingest and preview work that holds a request's body keeps it counted after the client leaves
# TYPE trawl_http_requests_in_progress gauge
trawl_http_requests_in_progress{allowance="regular"} 0
trawl_http_requests_in_progress{allowance="control"} 1
# HELP trawl_hot_buffer_bytes Current byte size of the hot buffer
# TYPE trawl_hot_buffer_bytes gauge
trawl_hot_buffer_bytes 6669279
